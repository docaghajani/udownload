{
  "manifest_version": 3,
  "name": "UDownload Integration",
  "version": "1.0.17",
  "description": "Send links and browser downloads to UDownload.",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "downloads",
    "storage",
    "scripting",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "UDownload",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
