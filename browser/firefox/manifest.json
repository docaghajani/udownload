{
  "manifest_version": 2,
  "name": "Ubuntu Download Manager Integration",
  "version": "1.0.0",
  "description": "Send links and browser downloads to Ubuntu Download Manager.",
  "browser_specific_settings": {"gecko": {"id": "udownload@ideveloper.local", "strict_min_version": "109.0"}},
  "permissions": ["menus", "nativeMessaging", "downloads", "storage", "tabs", "cookies", "<all_urls>"],
  "background": {"scripts": ["background.js"]},
  "browser_action": {"default_title": "Ubuntu Download Manager", "default_popup": "popup.html", "default_icon": "icon48.png"},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}],
  "icons": {"48": "icon48.png", "96": "icon96.png"}
}
